{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "apps/frontend",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "backend", "format": "url", "env": "BACKEND_URL" }]
    },
    "backend": {
      "root": "apps/backend",
      "framework": "nestjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
