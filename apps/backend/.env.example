# Copy to .env and fill in. Never commit .env.

# Port for local development (Vercel sets its own).
PORT=4000

# The public website, used in links inside messages (unsubscribe, consent, dashboards).
SITE_URL=http://localhost:3000

# Shared with the website: it must equal BACKEND_API_KEY in apps/frontend/.env.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKEND_API_KEY=

# Signs dashboard sessions and the links in messages. Changing it logs everyone out.
OLYMPIAD_TOKEN_SECRET=

# Same MongoDB as the website (see apps/frontend/.env.example). Or set DATABASE_URL instead.
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_HOST=
MONGODB_HOSTS=
MONGODB_REPLICA_SET=
MONGODB_DB=

# Outgoing email. Leave SMTP_HOST empty to only log mails.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Accounts from OLYMPIAD-SETUP.md. Empty = the feature logs instead of sending or charging.
TURNSTILE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
